# OpenChime daemon configuration.
#
# The daemon is configured entirely from its environment (ARCH-26) — there is no
# config file format to learn, and this is just an EnvironmentFile systemd hands
# to the process. Every variable is documented in docs/CONFIG.md.
#
# This file is a package conffile: your edits survive an upgrade, and dpkg/rpm
# will ask before overwriting it.

# --- Paths -------------------------------------------------------------------
# These are NOT the daemon's compiled-in defaults. Those point at /data, which
# suits the container image; under systemd the state lives in the unit's
# StateDirectory, which is the only writable path the sandbox allows.
OPENCHIME_DB_PATH=/var/lib/openchime/openchime.db
OPENCHIME_BLOB_DIR=/var/lib/openchime/blobs
OPENCHIME_TLS_CERT=/var/lib/openchime/cert.pem
OPENCHIME_TLS_KEY=/var/lib/openchime/key.pem

# --- Ports -------------------------------------------------------------------
# 8443 by default so installing the package cannot fail by colliding with a web
# server already on 443.
#
# For a real deployment ARCH-54 wants 443: it is the one port restrictive
# networks reliably allow outbound, and the only port third-party webhook
# senders speak. The unit already carries CAP_NET_BIND_SERVICE, so switching is
# this line plus `systemctl restart openchimed` — no root, no setcap.
OPENCHIME_PROTO_PORT=8443
# Plaintext /healthz and the landing page (ARCH-25). Bind this behind your
# firewall or a reverse proxy; it is not authenticated by design.
OPENCHIME_HEALTH_PORT=8080

# --- Identity ----------------------------------------------------------------
# Shown to clients in WORKSPACE_INFO.
#OPENCHIME_WORKSPACE_NAME=Acme Inc

# standalone | federated | managed (ARCH-76). Setting `federated` does not by
# itself enable anything — each federated service is gated on its own URL below.
OPENCHIME_DEPLOYMENT_MODE=standalone

# --- Federated services (all optional, all opt-in) ---------------------------
# Each is independently declinable; declining all of them is a stand-alone
# deployment with no runtime dependency on the OpenChime project at all.
#
# Enrollment against the control plane (ARCH-84). Prints an `oce1.` code to the
# journal on first run for you to reserve in the console.
#OPENCHIME_ENROLL_URL=https://openchime.io

# Mobile push relay (ARCH-16/85). Contentless — no message text leaves the box.
#OPENCHIME_PUSH_URL=https://openchime.io

# --- Authentication ----------------------------------------------------------
# local  = daemon-managed password accounts; the first owner comes from a
#          one-time setup token printed to the journal on first run (ARCH-59).
# oidc   = central relay (ARCH-56); requires the pinned key and issuer below.
OPENCHIME_AUTH_MODE=local
#OPENCHIME_OIDC_ISSUER=https://openchime.io
#OPENCHIME_OIDC_PUBKEY_FILE=/etc/openchime/oidc-pubkey.pem

# --- Limits ------------------------------------------------------------------
# 0 = unlimited. Set by the control plane on a managed box (CP-7).
#OPENCHIME_MAX_USERS=0
