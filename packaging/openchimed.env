# OpenChime daemon configuration.
#
# The daemon is configured entirely from its environment (ARCH-26); this is
# the EnvironmentFile systemd hands it. Every setting the daemon reads is
# here, at its default, commented; uncomment to change one. A value that
# does not parse or is out of range stops the daemon: test an edit with
#   openchimed --check-config --env-file /etc/openchime/openchimed.env
# docs/CONFIG.md explains each. Generated by `openchimed --config-env`.
#
# This file is a package conffile: your edits survive an upgrade.

# --- Core ---
# The deployment model (ARCH-76). `federated` enables nothing by itself: each service is gated on its own URL.
#OPENCHIME_DEPLOYMENT_MODE=standalone
# The workspace's display name, shown to clients; unset, a client derives one from the host.
#OPENCHIME_WORKSPACE_NAME=
# The workspace's canonical address, when it moved and still answers at the old one; clients re-file it under this.
#OPENCHIME_WORKSPACE_ADDRESS=
# The SQLite database; created and migrated by the daemon. The packages set `/var/lib/openchime/openchime.db`.
OPENCHIME_DB_PATH=/var/lib/openchime/openchime.db
# The certificate the daemon presents (PEM); with `OPENCHIME_TLS_SOURCE=self`, where it writes its own.
OPENCHIME_TLS_CERT=/var/lib/openchime/cert.pem
# Its private key (PEM).
OPENCHIME_TLS_KEY=/var/lib/openchime/key.pem
# The TLS port the protocol, the web client and the sign-in pages are served on (443 for a real deployment, ARCH-54).
#OPENCHIME_PROTO_PORT=8443
# The plaintext port for `/healthz` and the landing page (ARCH-25); 0 turns it off.
#OPENCHIME_HEALTH_PORT=8080
# The most registered users; 0 is unlimited. A managed box has it set by the control plane (CP-7).
#OPENCHIME_MAX_USERS=0
# Addresses or CIDRs whose PROXY protocol v2 header is believed, comma-separated; the connection's address is then the one the proxy saw.
#OPENCHIME_TRUSTED_PROXIES=

# --- Sessions and local sign-in ---
# How many days a session lives (REQ-181).
#OPENCHIME_SESSION_DAYS=30
# How many days a session may go unused; 0 is no idle limit.
#OPENCHIME_SESSION_IDLE_DAYS=0
# Whether local accounts are asked for a second step (AUTH.md §8.6).
#OPENCHIME_LOCAL_MFA=optional
# The key local accounts' second-step secrets are sealed under; unset, `factor.key` beside the database. Back it up with the database.
#OPENCHIME_FACTOR_KEY_FILE=

# --- Authentication ---
# Where accounts come from, comma-separated: `local` (passwords held here), `relay` or `oidc` (the central relay, ARCH-56); checked at startup.
#OPENCHIME_AUTH_MODE=local
# The relay's issuer URL, for `relay`.
#OPENCHIME_OIDC_ISSUER=
# The audience the relay's tokens carry for this workspace; an enrolled box derives it.
#OPENCHIME_OIDC_AUDIENCE=
# The relay's public key, PEM, inline. The control plane writes this form.
#OPENCHIME_OIDC_PUBKEY=
# The relay's public key, PEM, as a file; read at startup and preferred over the inline form.
#OPENCHIME_OIDC_PUBKEY_FILE=
# Who may join by signing in: `domain:`, `tenant:`, `subject:` and `owner:` rules, comma-separated (AUTH.md §3). Empty: only by invitation.
#OPENCHIME_OIDC_ALLOW=
# Whether an emailed code may sign into a person a provider knows (AUTH.md §8.4).
#OPENCHIME_OIDC_EMAIL_LINK=provider-only
# A direct connection to your own provider, 1 to 4 (AUTH.md §8.5): `label=…;issuer=https://…;client_id=…;secret_file=…;subject=sub|oid;redirect=127.0.0.1|localhost`.
#OPENCHIME_OIDC_CONNECT_1=

# --- Outbound TLS ---
# PEM roots trusted beside the built-in ones for every outbound connection (push, enrollment, unfurls, S3): a self-hosted service behind a private CA.
#OPENCHIME_EXTRA_CA=

# --- Certificates ---
# Where the daemon's certificate comes from (TLS.md): its own self-signed one, your files, ACME for OPENCHIME_TLS_NAME, or central. Unset: `central` on an enrolled managed box, else `self`.
#OPENCHIME_TLS_SOURCE=
# The DNS names to certify, comma-separated; required by `acme`.
#OPENCHIME_TLS_NAME=
# The ACME directory URL.
#OPENCHIME_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# The ACME account's contact address.
#OPENCHIME_ACME_EMAIL=

# --- Attachments and blob storage ---
# Where attachments are kept on local disk, and the filesystem whose free space the pressure policy measures. The packages set `/var/lib/openchime/blobs`.
OPENCHIME_BLOB_DIR=/var/lib/openchime/blobs
# The largest attachment, in bytes; the wire's cap (200 MiB) is the most it can be.
#OPENCHIME_MAX_ATTACHMENT_SIZE=209715200
# The largest video message, in bytes; at most the attachment size.
#OPENCHIME_MAX_VIDEO_MESSAGE_SIZE=167772160
# S3 instead of local disk (ARCH-70): the endpoint (`host`, `host:port`, or a URL whose scheme picks the transport). All four S3 values, or none.
#OPENCHIME_S3_ENDPOINT=
# The bucket.
#OPENCHIME_S3_BUCKET=
# The access key.
#OPENCHIME_S3_ACCESS_KEY=
# The secret key.
#OPENCHIME_S3_SECRET_KEY=
# The region SigV4 signs for.
#OPENCHIME_S3_REGION=us-east-1

# --- Storage pressure and maintenance ---
# Attachments older than this expire; 0 keeps them forever.
#OPENCHIME_ATTACH_MAX_AGE_DAYS=0
# Whether the oldest attachments are evicted when free space falls below OPENCHIME_PRESSURE_MB (REQ-215). Local disk only.
#OPENCHIME_EVICT=on
# Audit entries older than this age out, per family (REQ-251); 0 keeps them forever.
#OPENCHIME_AUDIT_MAX_DAYS=365

# --- Federated services ---
# The control plane to enrol with (ARCH-84): https, or http to loopback for a test. Prints an `oce1.` code to the log on first run.
#OPENCHIME_ENROLL_URL=
# Where the enrollment code is also written, for an installer to read.
#OPENCHIME_ENROLL_CODE_FILE=
# How long the first start waits for the enrollment to be claimed before serving anyway.
#OPENCHIME_ENROLL_WAIT_SECS=0
# A managed box's claim ticket, written by the control plane at provision time.
#OPENCHIME_ENROLL_TICKET=
# The mobile push relay (ARCH-16/85), contentless: https, or http to loopback for a test.
#OPENCHIME_PUSH_URL=
# Whether invitations bound to an address are reported to central for it to mail (REQ-280); needs an active enrollment.
#OPENCHIME_INVITE_MAIL=off

# --- Audio ---
# The call relay's UDP port; 0 is ephemeral (AUDIO.md §4).
#OPENCHIME_AUDIO_PORT=0
# The UDP port clients are told, where a front door maps it; 0 is the bound one.
#OPENCHIME_AUDIO_ADVERTISE_PORT=0
# Hex bytes (at most 16) that lead every relay token, so a front door can route by them.
#OPENCHIME_AUDIO_TOKEN_PREFIX=

# --- Calls and files ---
# The most people in one call (REQ-305); every participant mixes every other's stream.
#OPENCHIME_CALL_MAX=10

# --- Read-aloud ---
# Read-aloud (ARCH-111), in a build that carries it.
#OPENCHIME_TTS=on
# The language read in; the binary carries one and refuses another.
#OPENCHIME_TTS_LANG=en-US
# Where the voice data is; unset, `/usr/share/openchime/tts`, else `tts/` beside the executable.
#OPENCHIME_TTS_DATA_DIR=

# --- Voice input ---
# Voice input (ARCH-112), in a build that carries it.
#OPENCHIME_STT=on
# Where the recognizer's data is; unset, `/usr/share/openchime/stt`, else `stt/` beside the executable.
#OPENCHIME_STT_DATA_DIR=

# --- Summaries ---
# Summaries (REQ-310): `local` runs the model inside the daemon (fetched on first start), `cloud` names a hosted API.
#OPENCHIME_SUMMARY=off
# The hosted API's base URL, for `cloud`.
#OPENCHIME_SUMMARY_URL=
# The model there, for `cloud`.
#OPENCHIME_SUMMARY_MODEL=
# Its key.
#OPENCHIME_SUMMARY_API_KEY=
