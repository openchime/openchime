# Local dev credentials for the MinIO S3-simulation container. These are
# dev-only defaults and are never used for anything real — do not reuse
# them for an actual deployment.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Bucket created in the local MinIO container. Currently unused — the daemon's
# S3 blob backend (ARCH-70) defaults to the local filesystem and is not wired
# into compose.
OPENCHIME_BUCKET=openchime-dev
