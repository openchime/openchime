/* The VERSIONINFO resource both Windows binaries carry.
 *
 * Shared rather than duplicated because the two differ in exactly two strings.
 * An includer defines those and then includes this file:
 *
 *     #define OC_RES_DESC "Chat client for an OpenChime server."
 *     #define OC_RES_ORIG "openchime.exe"
 *     #include "version_info.rc"
 *
 * This is the block Explorer reads under Properties > Details, and the one a
 * bug report quotes. Without it a shipped .exe reports no version at all --
 * which was true of both binaries until this file existed, even though the
 * installer wrapping them carried one (packaging/windows/openchime.iss).
 *
 * The Makefile passes two bare tokens to windres: OC_BUILD_NUM, the candidate
 * build's run number, and OC_BUILD_ID_TOKEN, the short commit the daemon
 * reports as its build id (docs/UPGRADING.md). A source build leaves them
 * unset and gets 0 and "dev", matching the daemon.
 *
 * Only bare tokens cross the command line, and the strings are built here.
 * That is deliberate: windres hands its arguments to the preprocessor through
 * a second shell, so a --define carrying quotes loses them on the way and the
 * string literal arrives as bare tokens. A number, or a commit's hex, has no
 * such problem; both are stringified below.
 *
 * Why 1.0.<run>.0: Windows wants four numeric fields and compares them, so the
 * one thing a build has that only grows is the run number of the candidate
 * build that made it. A release number is assigned afterwards and lives in
 * the installer and the MSIX manifest, not in the file. The build id is the
 * ProductVersion string, which is free text, so Properties > Details names
 * the commit a bug report should quote.
 */
#include <windows.h>

#ifndef OC_BUILD_NUM
#define OC_BUILD_NUM 0
#endif
#ifndef OC_BUILD_ID_TOKEN
#define OC_BUILD_ID_TOKEN dev
#endif

/* Two levels, because # does not expand its argument: the outer macro expands
   the token and the inner one stringifies the result. */
#define OC_RES_STR_(x) #x
#define OC_RES_STR(x)  OC_RES_STR_(x)
#define OC_FILE_VERSION_STR "1.0." OC_RES_STR(OC_BUILD_NUM) ".0"
#define OC_BUILD_ID_STR     "build " OC_RES_STR(OC_BUILD_ID_TOKEN)

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,OC_BUILD_NUM,0
PRODUCTVERSION 1,0,OC_BUILD_NUM,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0409 is en-US, 04B0 is codepage 1200 (Unicode). The VarFileInfo
           translation below must name the same pair. */
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "OpenChime"
            VALUE "FileDescription",  OC_RES_DESC
            VALUE "FileVersion",      OC_FILE_VERSION_STR
            VALUE "InternalName",     OC_RES_ORIG
            VALUE "OriginalFilename", OC_RES_ORIG
            VALUE "ProductName",      "OpenChime"
            VALUE "ProductVersion",   OC_BUILD_ID_STR
            VALUE "LegalCopyright",   "Copyright (c) OpenChime LLC"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
