#!/usr/bin/env bash
# The fast suite is the gate for a push and a pull request (docs/TESTING.md):
# a pull request runs its policy checks (pr-policy), and no test, and the full
# suite runs once per release-candidate. So `make test` is the one test every
# change gets before it lands, and this refuses a push without it:
#
#   - a branch whose tip tree `make test` did not pass on (it records each
#     tree it passes, scripts/test/lib/tested_tree.sh) -- unless what the
#     branch changes since staging is documentation alone
#     (scripts/policy/docs_only.sh, the one rule);
#   - a branch whose tip's subject pr-policy would refuse as a title
#     (scripts/policy/subject.sh, the one rule).
#
# Turned on once per clone: git config core.hooksPath .githooks
set -uo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue           # a deletion
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch=${remote_ref#refs/heads/}

  tree=$(git rev-parse "${local_sha}^{tree}")
  if ! "$root/scripts/test/lib/tested_tree.sh" has "$tree"; then
    base=$(git merge-base "$local_sha" origin/staging 2>/dev/null) || base=""
    if [ -z "$base" ] || ! "$root/scripts/policy/docs_only.sh" "$base" "$local_sha" >/dev/null; then
      echo "pre-push: ${branch} at ${local_sha:0:8} was not tested locally: run make test, then push" >&2
      fail=1
    fi
  fi

  "$root/scripts/policy/subject.sh" "$(git log -1 --format=%s "$local_sha")" || {
    echo "pre-push: ${branch} at ${local_sha:0:8}: its subject is the pull request's title, and pr-policy would refuse it" >&2
    fail=1
  }
done
exit "$fail"
