#!/usr/bin/env bash
# Every push here is one CI will run in full, and a run is billed by the
# minute. This refuses the pushes that would only spend them:
#
#   - a branch whose tip tree scripts/check/test.sh did not pass on (the local
#     test /oc-feature-finish runs) -- unless it changes only documentation,
#     which CI does not build either;
#   - a push while a CI run for the branch is still going: it would cancel that
#     run part way, billed for what it had done;
#   - workflows actionlint rejects, when the push changes any.
#
# Turned on once per clone with the other hooks: git config core.hooksPath .githooks
set -uo pipefail
root=$(git rev-parse --show-toplevel)
stamp="$(git rev-parse --git-dir)/oc-tested-tree"
zero=0000000000000000000000000000000000000000
fail=0

docs_only() {  # $1 the commit: everything it changes since staging is documentation
  local base files
  base=$(git merge-base "$1" origin/staging 2>/dev/null) || return 1
  files=$(git diff --name-only "$base" "$1") || return 1
  [ -n "$files" ] || return 0
  ! printf '%s\n' "$files" | grep -qvE '(\.md$|^\.gitignore$|^\.claude/)'
}

actionlint_bin() {
  local v=1.7.12 sum=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/openchime/actionlint-$v"
  if [ ! -x "$dir/actionlint" ]; then
    mkdir -p "$dir" || return 1
    curl -fsSL -o "$dir/a.tgz" "https://github.com/rhysd/actionlint/releases/download/v$v/actionlint_${v}_linux_amd64.tar.gz" || return 1
    echo "$sum  $dir/a.tgz" | sha256sum -c --quiet - || { rm -f "$dir/a.tgz"; return 1; }
    tar -xzf "$dir/a.tgz" -C "$dir" actionlint && rm -f "$dir/a.tgz" || return 1
  fi
  printf '%s\n' "$dir/actionlint"
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue           # a deletion
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch=${remote_ref#refs/heads/}

  tree=$(git rev-parse "${local_sha}^{tree}")
  if ! grep -qxF "$tree" "$stamp" 2>/dev/null && ! docs_only "$local_sha"; then
    echo "pre-push: ${branch} at ${local_sha:0:8} was not tested locally: run scripts/check/test.sh, then push" >&2
    fail=1
  fi

  if command -v gh >/dev/null 2>&1; then
    running=$(gh run list -b "$branch" -L 20 --json status -q '[.[] | select(.status != "completed")] | length' 2>/dev/null || echo 0)
    if [ "${running:-0}" -gt 0 ]; then
      echo "pre-push: ${running} run(s) for ${branch} are still going; push once they have finished, with every fix in one push" >&2
      fail=1
    fi
  fi

  base=$([ "$remote_sha" != "$zero" ] && echo "$remote_sha" || git merge-base "$local_sha" origin/staging 2>/dev/null)
  if [ -n "$base" ] && git diff --name-only "$base" "$local_sha" -- .github/workflows | grep -q .; then
    if lint=$(actionlint_bin); then
      (cd "$root" && "$lint" -shellcheck= ) || { echo "pre-push: actionlint rejects the workflows" >&2; fail=1; }
    else
      echo "pre-push: could not fetch actionlint to check the workflows" >&2; fail=1
    fi
  fi
done
exit "$fail"
