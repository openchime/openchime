openchimed
# Read-aloud's data directory, assembled by `make` beside the binary.
/tts/
# The web client the daemon serves, placed beside the binary by its build.
/web/
/build/
# Release artefacts (.deb/.rpm/.tar.gz and the stripped binary they share),
# produced by packaging/build-*.sh and by the release workflow. Built, never
# committed — the published copies live in the published package repository
# (ARCH-20).
dist/
# Ignore what is built or fetched into third_party/ (scripts/build/*.sh), and
# keep the sources committed there (docs/details/VENDORS.md §1). (Ignore the *contents*
# with /* rather than the directory, so re-inclusion below is possible.)
/third_party/*
!/third_party/jsmn/
!/third_party/picohttpparser/
!/third_party/termbox2/
!/third_party/utf8proc/
!/third_party/argon2/
!/third_party/pwlist/
!/third_party/lucide/
!/third_party/qrcodegen/
!/third_party/miniaudio/
!/third_party/stb/
!/third_party/fonts/
!/third_party/sqlite-3.53.4/
!/third_party/libfvad/
!/third_party/ca-roots/
!/third_party/speexdsp/
!/third_party/opus/
!/third_party/libvpx/
!/third_party/mbedtls/
!/third_party/SDL3/
!/third_party/libavc/
!/third_party/lame/
!/third_party/libjpeg-turbo/
!/third_party/libspng/
!/third_party/libwebp/
!/third_party/miniz/
*.o
*.db
*.db-shm
*.db-wal
.env
.playwright-mcp/
__pycache__/
/stt/

